<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cz_jmhz_submission_view_list" model="ir.ui.view">
        <field name="name">cz.jmhz.submission.list</field>
        <field name="model">cz.jmhz.submission</field>
        <field name="arch" type="xml">
            <list create="false" decoration-muted="state == 'superseded'" decoration-danger="state in ('invalid', 'rejected')">
                <field name="create_date" string="Vytvořeno"/>
                <field name="name"/>
                <field name="kind"/>
                <field name="submission_type" optional="show"/>
                <field name="regzec_action" optional="show"/>
                <field name="sent_date" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'accepted'" decoration-info="state in ('ready', 'sent')"/>
            </list>
        </field>
    </record>

    <record id="cz_jmhz_submission_view_form" model="ir.ui.view">
        <field name="name">cz.jmhz.submission.form</field>
        <field name="model">cz.jmhz.submission</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_download" type="object" string="Stáhnout XML" class="btn-primary" invisible="state not in ('ready', 'sent', 'accepted')"/>
                    <button name="action_mark_sent" type="object" string="Označit jako podané" invisible="state != 'ready'"
                            confirm="Nahráli jste XML na ePortál ČSSZ a odeslali ho?"/>
                    <button name="action_mark_accepted" type="object" string="Přijato" invisible="state != 'sent'"/>
                    <button name="action_mark_rejected" type="object" string="Zamítnuto" invisible="state != 'sent'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,sent,accepted"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert" invisible="state != 'ready'">
                        Na <a href="https://eportal.cssz.cz" target="_blank">ePortálu ČSSZ</a> použijte službu
                        <b>Podání nahráním dat z účetního systému</b>. Nahraná data už na ePortálu nejde upravit; když je potřeba
                        něco změnit, opravte to v Odoo a připravte nové XML.
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="kind" readonly="1"/>
                            <field name="submission_type" readonly="1" invisible="kind != 'mh'"/>
                            <field name="regzec_action" readonly="1" invisible="kind != 'regzec'"/>
                            <field name="report_id" readonly="1" invisible="not report_id"/>
                            <field name="employment_id" readonly="1" invisible="not employment_id"/>
                            <field name="employee_id" invisible="not employment_id"/>
                        </group>
                        <group>
                            <field name="guid" invisible="not guid"/>
                            <field name="xml_file" filename="xml_filename"/>
                            <field name="xml_filename" invisible="1"/>
                            <field name="xsd_version"/>
                            <field name="sent_date"/>
                            <field name="response_file" filename="response_filename"/>
                            <field name="response_filename" invisible="1"/>
                        </group>
                    </group>
                    <group string="Chyby XSD" invisible="not xsd_errors">
                        <field name="xsd_errors" nolabel="1" colspan="2"/>
                    </group>
                    <field name="note" placeholder="Poznámka, číslo podání z ePortálu…"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="cz_jmhz_submission_view_search" model="ir.ui.view">
        <field name="name">cz.jmhz.submission.search</field>
        <field name="model">cz.jmhz.submission</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="mh" string="Měsíční hlášení" domain="[('kind', '=', 'mh')]"/>
                <filter name="regzec" string="Registrace" domain="[('kind', '=', 'regzec')]"/>
                <separator/>
                <filter name="ready" string="K podání" domain="[('state', '=', 'ready')]"/>
                <filter name="not_superseded" string="Bez nahrazených" domain="[('state', '!=', 'superseded')]"/>
            </search>
        </field>
    </record>

    <record id="cz_jmhz_submission_action" model="ir.actions.act_window">
        <field name="name">Podání ČSSZ</field>
        <field name="res_model">cz.jmhz.submission</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_superseded': 1}</field>
    </record>
</odoo>
